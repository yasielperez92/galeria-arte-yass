rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "67KwvGqOA9Ta1AI8mfZ8Xes2xS02";
    }

    match /obras/{obraId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /configuracion/{documentId} {
      allow get: if documentId == "artista";
      allow list: if false;
      allow create, update, delete: if documentId == "artista" && isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
